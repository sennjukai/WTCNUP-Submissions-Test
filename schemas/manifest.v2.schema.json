{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/wtcnup/manifest-v2.schema.json",
  "title": "WTCNUP submission manifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "submission_uid", "file_count", "total_size", "files"],
  "properties": {
    "schema_version": { "type": "integer", "const": 2 },
    "submission_uid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "file_count": { "type": "integer", "minimum": 1, "maximum": 300 },
    "total_size": { "type": "integer", "minimum": 0, "maximum": 52428800 },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 300,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "size", "sha256"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240,
            "pattern": "^(?:[^/]+/)*[^/.]+\\.(?:csv|blk)$"
          },
          "size": { "type": "integer", "minimum": 0, "maximum": 10485760 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    }
  }
}
